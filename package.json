{
  "name": "lipek-platform",
  "version": "0.1.0",
  "private": true,
  "description": "LIPEK Intelligent Fashion Commerce & Services Platform — pnpm monorepo (Vendure Core, NestJS, Next.js, Mastra).",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "pnpm --filter @lipek/server dev",
    "dev:storefront": "pnpm --filter @lipek/storefront dev"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "^5.9.3"
  }
}
