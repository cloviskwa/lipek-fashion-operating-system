# Copy to .env and fill in real (local-only) values. Never commit .env.
# See docs/implementation/environment-variables.md for the authoritative
# description of every variable below, including which task/phase wires
# it up and what it must never be used for.

# --- Runtime ---
# dev | production. Controls Vendure's dev-only conveniences (GraphQL
# debug info, the local dev mailbox) -- see src/vendure-config.ts.
APP_ENV=dev

# Port the Vendure server listens on. Hosting platforms typically inject
# PORT at runtime, which src/vendure-config.ts prefers over this value.
VENDURE_SERVER_PORT=3000

# --- Session / cookie signing ---
# Random string used to sign session cookies. Generate a fresh one per
# environment, e.g.: openssl rand -base64 24
COOKIE_SECRET=replace-with-a-random-string-per-environment

# --- Superadmin bootstrap account ---
# Vendure creates this account on first boot if it does not already
# exist. Change both values before any shared (non-solo-local) environment
# -- the scaffold's own boot log warns loudly if the default is left in
# place. Never reuse across environments.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# --- PostgreSQL connection ---
# Matches apps/server/docker-compose.yml's postgres_db service by default
# for local development. Port 6543 (not the Postgres default 5432) is a
# deliberate scaffold choice to avoid colliding with any other local
# Postgres instance.
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-random-string-per-environment
DB_SCHEMA=public

# --- Telemetry ---
# Vendure sends anonymous usage telemetry by default. Uncomment to disable.
# VENDURE_DISABLE_TELEMETRY=true
